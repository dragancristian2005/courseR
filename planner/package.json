{
  "name": "planner",
  "private": true,
  "description": "A university timetable, homework and exam planner: an installable web app with Firebase sync, timetable import and Google Classroom import.",
  "license": "MIT",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "firebase": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "firebase-tools": "^15.35.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p __tests__ && tsc --noEmit -p rules-tests",
    "build:web": "expo export -p web && node scripts/stamp-sw.js",
    "demo": "EXPO_PUBLIC_DEMO=1 expo start --web",
    "build:demo": "EXPO_PUBLIC_DEMO=1 expo export -p web --output-dir dist-demo",
    "deploy": "npm run build:web && firebase deploy --only hosting,firestore:rules",
    "icons": "node scripts/make-icons.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-planner \"jest -c rules-tests/jest.config.js\""
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/rules-tests/"
    ]
  }
}
